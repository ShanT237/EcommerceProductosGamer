              ]
            },
            "description": "Debe responder 422: la reseña ya asignó puntos y la regla del dominio (Compra.solicitarReembolso) rechaza el reembolso."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Regla de negocio rota: responde 422\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"El mensaje explica la regla\", function () { pm.expect(JSON.stringify(pm.response.json())).to.include(\"puntos\"); });"
                ]
              }
            }
          ]
        },
