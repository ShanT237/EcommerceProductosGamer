{
  "info": {
    "name": "Marketplace Gamer - Entrega 2 (flujo punta a punta)",
    "description": "Requiere el backend corriendo (bootRun) con datos de data.sql. Ejecutar la carpeta A en orden. Cambiar baseUrl si el puerto no es 8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A. Flujo punta a punta",
      "item": [
        {
          "name": "1. Login vendedor (GamerZone)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"demo@gamerzone.com\",\n  \"contrasena\": \"GamerZone2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login: responde 200\", function () { pm.response.to.have.status(200); });",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set(\"tokenVendedor\", token);",
                  "pm.test(\"Devuelve un token JWT\", function () { pm.expect(token).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Publicar producto (VENDEDOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
