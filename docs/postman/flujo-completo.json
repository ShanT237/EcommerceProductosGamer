                  "pm.collectionVariables.set(\"cuponCodigo\", \"ENS\" + Date.now().toString(36).toUpperCase());",
                  "pm.collectionVariables.set(\"cuponVence\", new Date(Date.now() + 30 * 864e5).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Crear cupon: responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Nace sin usos\", function () { pm.expect(pm.response.json().usos).to.eql(0); });",
                  "pm.test(\"Es un cupon de vendedor (con dueno)\", function () { pm.expect(pm.response.json().vendedorId).to.be.a(\"string\"); });"
                ]
              }
            }
