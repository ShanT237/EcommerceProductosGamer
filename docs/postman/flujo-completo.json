              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Audifonos Gamer Surround 7.1\",\n  \"descripcion\": \"Sonido envolvente 7.1 con microfono desmontable\",\n  \"precio\": 180000,\n  \"stock\": 10,\n  \"gama\": \"ALTA\",\n  \"exclusividad\": \"NORMAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVendedor}}",
                  "type": "string"
                }
              ]
            },
            "description": "Publica un producto. Guarda su id en la variable productoId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Publicar: responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"productoId\", pm.response.json().id);"
                ]
              }
            }
          ]
